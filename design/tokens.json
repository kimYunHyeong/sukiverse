  "borderRadius": {
    "none": { "$value": "0",      "$type": "borderRadius" },
    "sm":   { "$value": "0.4rem", "$type": "borderRadius" },
    "md":   { "$value": "0.6rem", "$type": "borderRadius" },
    "lg":   { "$value": "0.8rem", "$type": "borderRadius" },
    "xl":   { "$value": "1.2rem", "$type": "borderRadius" },
    "2xl":  { "$value": "1.6rem", "$type": "borderRadius" },
    "full": { "$value": "9999px", "$type": "borderRadius" }
  }
}
