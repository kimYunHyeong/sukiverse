{
  "color": {
    "primary": {
      "50":  { "$value": "#fefce8", "$type": "color" },
      "100": { "$value": "#fef9c3", "$type": "color" },
      "200": { "$value": "#fef08a", "$type": "color" },
      "300": { "$value": "#fde047", "$type": "color" },
      "400": { "$value": "#facc15", "$type": "color" },
      "500": { "$value": "#eab308", "$type": "color" },
      "600": { "$value": "#ca8a04", "$type": "color" },
      "700": { "$value": "#a16207", "$type": "color" },
      "800": { "$value": "#854d0e", "$type": "color" },
      "900": { "$value": "#713f12", "$type": "color" }
    },
    "neutral": {
      "50":  { "$value": "#fafafa", "$type": "color" },
      "100": { "$value": "#f5f5f5", "$type": "color" },
      "200": { "$value": "#e5e5e5", "$type": "color" },
      "300": { "$value": "#d4d4d4", "$type": "color" },
      "400": { "$value": "#a3a3a3", "$type": "color" },
      "500": { "$value": "#737373", "$type": "color" },
      "600": { "$value": "#525252", "$type": "color" },
      "700": { "$value": "#404040", "$type": "color" },
      "800": { "$value": "#262626", "$type": "color" },
      "900": { "$value": "#171717", "$type": "color" },
      "950": { "$value": "#0a0a0a", "$type": "color" }
    },
    "semantic": {
      "background": { "$value": "{color.neutral.950}", "$type": "color" },
      "surface":    { "$value": "{color.neutral.900}", "$type": "color" },
      "border":     { "$value": "{color.neutral.800}", "$type": "color" },
      "text": {
        "primary":   { "$value": "{color.neutral.50}",  "$type": "color" },
        "secondary": { "$value": "{color.neutral.400}", "$type": "color" },
        "disabled":  { "$value": "{color.neutral.600}", "$type": "color" }
      },
      "brand": {
        "default":  { "$value": "{color.primary.400}", "$type": "color" },
        "hover":    { "$value": "{color.primary.300}", "$type": "color" },
        "active":   { "$value": "{color.primary.500}", "$type": "color" },
        "subtle":   { "$value": "{color.primary.900}", "$type": "color" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "$value": "Pretendard, sans-serif", "$type": "fontFamilies" }
    },
    "fontSize": {
      "xs":   { "$value": "1.2rem", "$type": "fontSizes" },
      "sm":   { "$value": "1.4rem", "$type": "fontSizes" },
      "base": { "$value": "1.6rem", "$type": "fontSizes" },
      "lg":   { "$value": "1.8rem", "$type": "fontSizes" },
      "xl":   { "$value": "2rem",   "$type": "fontSizes" },
      "2xl":  { "$value": "2.4rem", "$type": "fontSizes" },
      "3xl":  { "$value": "3rem",   "$type": "fontSizes" },
      "4xl":  { "$value": "3.6rem", "$type": "fontSizes" }
    },
    "fontWeight": {
      "regular":  { "$value": "400", "$type": "fontWeights" },
      "medium":   { "$value": "500", "$type": "fontWeights" },
      "semibold": { "$value": "600", "$type": "fontWeights" },
      "bold":     { "$value": "700", "$type": "fontWeights" }
    },
    "lineHeight": {
      "tight":  { "$value": "1.25", "$type": "lineHeights" },
      "normal": { "$value": "1.5",  "$type": "lineHeights" },
      "relaxed":{ "$value": "1.75", "$type": "lineHeights" }
    }
  },
  "spacing": {
    "1":  { "$value": "0.4rem",  "$type": "spacing" },
    "2":  { "$value": "0.8rem",  "$type": "spacing" },
    "3":  { "$value": "1.2rem",  "$type": "spacing" },
    "4":  { "$value": "1.6rem",  "$type": "spacing" },
    "5":  { "$value": "2rem",    "$type": "spacing" },
    "6":  { "$value": "2.4rem",  "$type": "spacing" },
    "8":  { "$value": "3.2rem",  "$type": "spacing" },
    "10": { "$value": "4rem",    "$type": "spacing" },
    "12": { "$value": "4.8rem",  "$type": "spacing" },
    "16": { "$value": "6.4rem",  "$type": "spacing" },
    "20": { "$value": "8rem",    "$type": "spacing" },
    "24": { "$value": "9.6rem",  "$type": "spacing" }
