      "modal": {
        "$type": "boxShadow",
        "$value": "{primitive.shadow.xl}"
      },
      "dropdown": {
        "$type": "boxShadow",
        "$value": "{primitive.shadow.lg}"
      },
      "focus": {
        "$type": "boxShadow",
        "$value": "{primitive.shadow.brand}"
      }
    },
    "motion": {
      "duration": {
        "instant": {
          "$type": "other",
          "$value": "{primitive.duration.instant}"
        },
        "micro": {
          "$type": "other",
          "$value": "{primitive.duration.fast}",
          "$description": "hover 상태 전환"
        },
        "standard": {
          "$type": "other",
          "$value": "{primitive.duration.normal}",
          "$description": "대부분의 트랜지션"
        },
        "emphasis": {
          "$type": "other",
          "$value": "{primitive.duration.slow}",
          "$description": "페이지 전환, 모달"
        }
      },
      "easing": {
        "standard": {
          "$type": "other",
          "$value": "{primitive.easing.default}"
        },
        "enter": {
          "$type": "other",
          "$value": "{primitive.easing.out}"
        },
        "exit": {
          "$type": "other",
          "$value": "{primitive.easing.in}"
        },
        "spring": {
          "$type": "other",
          "$value": "{primitive.easing.spring}"
        }
      }
    }
  }
